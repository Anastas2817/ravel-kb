DartConfiguration.tcl
Makefile
*.cmake.in
!cmake/*.cmake       # наши собственные модули сохраняем

# CTest: создаёт Testing/ там, откуда запущен ctest (в т.ч. из корня репо)
Testing/

# Пресеты CMake: общие коммитятся (CMakePresets.json), личные — нет
CMakeUserPresets.json

# vcpkg (manifest-режим)
vcpkg_installed/

