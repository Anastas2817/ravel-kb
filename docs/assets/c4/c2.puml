@startuml C2
skinparam shadowing false
skinparam componentStyle rectangle
skinparam rectangle {
  RoundCorner 12
}
skinparam package {
  RoundCorner 16
}
skinparam legend {
  RoundCorner 12
}
top to bottom direction
title C2 — Containers

actor "User" as User

package "Ravel" {

  rectangle "UI (Qt 6 Widgets)" as UI #BurlyWood
  rectangle "App\nединственный источник мутаций" as App #Tan
  rectangle "Core (C++23, без Qt)" as Core #LightSkyBlue
  rectangle "Storage (nlohmann/json)" as Storage #MistyRose
}

rectangle "JSON-файлы" as Json <<внешняя система>> #MistyRose

User --> UI : жесты пользователя
UI --> App : действия (команды)
App --> UI : read-модель (NodeView / RelationView)
App --> Core : command-мутации
Storage --> Core : знает GraphSnapshot
App --> Storage : Open / Save / SaveAs (путь)
Storage <--> Json

legend bottom
  Ответственности:
  Core — модель и алгоритмы над ней: хранение графа,
  инварианты, раскладка (план), анализ структуры (план).
  App — обслуживать сценарии пользователя:
  создать/изменить/удалить узел/отношение, undo/redo;
  единственная дверь к мутациям Graph (инвариант 7).
  UI — канвас с зумом/pan, диалоги создания
  и редактирования, выделение и удаление одним
  жестом; отображение подсказок Algorithm (план).
  Storage — сериализация и десериализация,
  валидация формата и версии.

  Внутренние компоненты контейнеров (CommandChronicle,
  Graph, JsonStorage и др.) — на C3.
end legend
@enduml
