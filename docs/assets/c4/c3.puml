@startuml C3
skinparam shadowing false
skinparam componentStyle rectangle
skinparam rectangle {
  RoundCorner 12
}
skinparam package {
  RoundCorner 16
}
skinparam legend {
  RoundCorner 12
}
left to right direction
title C3 — Components

package "Core" {

  rectangle "Graph" as Graph #LightSkyBlue
  rectangle "GraphSnapshot" as Snapshot
  rectangle "Layout" as Layout
  rectangle "Algorithms" as Algo

  Layout --> Graph : читает структуру
  Algo --> Graph : читает структуру
  Graph --> Snapshot : ToSnapshot
  Snapshot --> Graph : FromSnapshot
}

package "App" {
  package "Controller" as Ctrl {
    rectangle "SessionState" as Session
  }
  rectangle "Command" as Cmd
}

package "UI" {
  rectangle "Canvas" as Canvas
}

package "Storage" {
  rectangle "JsonStorage" as JsonS
}

Ctrl --> Cmd : запрос
Cmd --> Graph : command-мутации
Ctrl --> Algo : анализ
Ctrl --> Layout : геометрия
JsonS --> Snapshot
Canvas --> Ctrl : жест пользователя - отклик

legend bottom
  Ответственности (одной фразой):
  Graph — хранить модель предметной области и
  поддерживать корректное состояние карты знаний.
  GraphSnapshot — переносить состояние Graph между
  слоями без знания формата.
  Layout — преобразовывать граф в пространственную
  раскладку (выдавать координаты). Планируется.
  Algorithms — анализировать структуру Graph:
  DFS, PageRank, циклы. Планируется.
  Canvas — планируется (этапы 2 и 4).

  Зависимости читателей: Layout и Algorithms —
  клиенты Graph, Graph о них не знает (защита
  от God Object: Graph отвечает только за
  корректное состояние).
end legend
@enduml
